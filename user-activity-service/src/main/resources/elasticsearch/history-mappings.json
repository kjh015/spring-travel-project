{
  "dynamic": "strict",
  "date_detection": false,
  "dynamic_templates": [
    {
      "strings_as_keyword": {
        "match_mapping_type": "string",
        "mapping": {
          "type": "keyword",
          "ignore_above": 256
        }
      }
    },
    {
      "integers_as_long": {
        "match_mapping_type": "long",
        "mapping": {
          "type": "long"
        }
      }
    },
    {
      "decimals_as_double": {
        "match_mapping_type": "double",
        "mapping": {
          "type": "double"
        }
      }
    },
    {
      "booleans_as_boolean": {
        "match_mapping_type": "boolean",
        "mapping": {
          "type": "boolean"
        }
      }
    }
  ],
  "properties": {
    "@timestamp": {
      "type": "date"
    },
    "id": {
      "type": "keyword"
    },
    "traceId": {
      "type": "keyword"
    },
    "log_process_id": {
      "type": "keyword"
    },
    "log_process_name": {
      "type": "keyword"
    },
    "success": {
      "type": "boolean"
    },
    "fail_info": {
      "properties": {
        "code": { "type": "keyword" },
        "stage": { "type": "keyword" },
        "fail_rule_id": { "type": "keyword" },
        "fail_rule_name": { "type": "keyword" },
        "detail": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        }
      }
    },
    "log_data": {
      "type": "object",
      "dynamic": true,
      "properties": {
        "staySeconds": { "type": "long", "ignore_malformed": true },
        "resultCount": { "type": "integer", "ignore_malformed": true },
        "rank": { "type": "integer", "ignore_malformed": true },
        "position": { "type": "integer", "ignore_malformed": true },
        "star": { "type": "integer", "ignore_malformed": true },
        "isLoggedIn": { "type": "boolean" }
      }
    },
    "createdAt": {
      "type": "date",
      "format": "strict_date_optional_time_nanos||strict_date_optional_time||epoch_millis"
    },
    "updatedAt": {
      "type": "date",
      "format": "strict_date_optional_time_nanos||strict_date_optional_time||epoch_millis"
    }
  }
}
