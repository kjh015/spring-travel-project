#!/bin/sh

PROJECT_ROOT=$(git rev-parse --show-toplevel)
cd "$PROJECT_ROOT" || exit

echo "🔍 Spotless로 코드 스타일을 확인하고 교정하는 중..."

# 스테이징된 Java 파일 목록 추출
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.java$')

if [ -z "$STAGED_FILES" ]; then
    echo "✅ Java 변경 사항이 없어 통과합니다."
    exit 0
fi

# gradlew 실행 권한 확인 및 실행
if [ -f "./gradlew" ]; then
    ./gradlew spotlessApply
else
    echo "❌ gradlew를 찾을 수 없습니다. (경로: $PROJECT_ROOT)"
    exit 1
fi

# 만약 Spotless 작업 중 오류가 발생하면 커밋 중단
if [ $? -ne 0 ]; then
    echo "❌ Spotless 실행 중 오류가 발생했습니다. 코드를 확인해 주세요."
    exit 1
fi

# Spotless에 의해 수정된 파일들을 다시 스테이징
for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then
        git add "$FILE"
    fi
done

echo "✅ 코드 스타일 교정 완료! 커밋을 진행합니다."